{
  "name": "@yangzhe1991/dsh-web-enhance",
  "version": "0.2.0",
  "description": "DSH Web UI 增强插件:思维链默认展开、DeepSeek 官方 API 会话价格统计、文件用系统默认程序打开、跑完提醒(提示音 + 标签页标题) | DSH Web UI enhancement plugin: thinking-chain default-expand, session cost meter for the official DeepSeek API, opening files in the desktop default app & a completion alert (chime + tab title)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangzhe1991/dsh-web-enhance.git"
  },
  "homepage": "https://github.com/yangzhe1991/dsh-web-enhance",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-job-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-job-controller": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
